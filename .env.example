# ==============================================================================
# Humming Drops & MedCity Smiles - Environment Configuration Matrix
# Target Environments: Local Development | Staging Isolation | Production
#
# CRITICAL SECURITY DIRECTIVES:
# 1. NEVER commit actual credentials, database passwords, or private keys to git.
# 2. NEVER prefix backend secrets with NEXT_PUBLIC_ (e.g. SERVICE_ROLE_KEY, KEY_SECRET).
#    Any variable with NEXT_PUBLIC_ is inlined into the client JavaScript bundle.
# 3. Always maintain strict isolation between Staging and Production infrastructure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node & Application Runtime
# ------------------------------------------------------------------------------
# Environment identifier: 'development' | 'staging' | 'production'
NODE_ENV=development
APP_ENV=development

# Server binding configuration (Railway automatically binds PORT)
PORT=3000
HOSTNAME=0.0.0.0

# Canonical Public Application URL
# Local: http://localhost:3000
# Staging: https://staging.hummingdrops.com (or Railway staging domain)
# Production: https://www.hummingdrops.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Fulfillment & Checkout Mode Configuration (Strategy Pattern)
# ------------------------------------------------------------------------------
# Server-authoritative checkout mode: 'assisted_lead' (Mode B) or 'online_gateway' (Mode A)
CHECKOUT_MODE=assisted_lead

# Client presentation hint only (NEVER trusted by server for authorization or pricing)
NEXT_PUBLIC_CHECKOUT_MODE=assisted_lead

# ------------------------------------------------------------------------------
# 3. Official Contact & Hub Details (Reference: Client Brochure)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_OFFICIAL_PHONE=8618902810
NEXT_PUBLIC_OFFICIAL_EMAIL=hummingdrops@gmail.com
NEXT_PUBLIC_OFFICIAL_LOCATION="Berrybeats cafe, Bangalore"

# ------------------------------------------------------------------------------
# 4. Persistence Architecture: PostgreSQL (Railway Managed DB / Drizzle ORM)
# ------------------------------------------------------------------------------
# Target: PostgreSQL 16+ on Railway
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# STAGING: postgresql://postgres:[staging_pwd]@roundhouse.proxy.rlwy.net:[port]/hummingdrops_staging
# PRODUCTION: postgresql://postgres:[prod_pwd]@roundhouse.proxy.rlwy.net:[port]/hummingdrops_prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hummingdrops_dev
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 5. Payment Gateway: Razorpay (Mode A - Online Gateway)
# ------------------------------------------------------------------------------
# Public Key ID (Client-side checkout modal)
# STAGING / TEST: rzp_test_xxxxxxxxxxxxxx
# PRODUCTION: rzp_live_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Private Secret Key (Server-side order generation & verification ONLY)
# CAUTION: NEVER expose in client bundles. NEVER prefix with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_server_only

# Webhook Secret (HMAC-SHA256 signature verification for asynchronous events)
# CAUTION: NEVER expose in client bundles. Keep isolated per environment.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_server_only

# ------------------------------------------------------------------------------
# 6. Authentication & Session Security (Supabase / NextAuth)
# ------------------------------------------------------------------------------
# Public Supabase API credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key (Bypasses Row-Level Security for system administrative tasks)
# EXTREME DANGER: Server-side only! Never expose to client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Cryptographic Session & Cookie Encryption Secret (Minimum 32 bytes random string)
SESSION_SECRET=generate_a_random_32_character_cryptographic_secret_here

# ------------------------------------------------------------------------------
# 7. Preventative Health Records Storage (MedCity Vitals & Diagnostic PDFs)
# ------------------------------------------------------------------------------
# Private S3 / Supabase Storage bucket for HIPAA/PII compliant PDF storage
STORAGE_BUCKET_HEALTH_REPORTS=medcity-vitals-private
STORAGE_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 8. Observability & Error Diagnostics
# ------------------------------------------------------------------------------
LOG_LEVEL=info
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ==============================================================================
# ENVIRONMENT ISOLATION AUDIT MATRIX
# ==============================================================================
# Dimension            | Local Dev              | Staging Isolated       | Production
# ---------------------+------------------------+------------------------+-------------------------
# Database Instance    | Local Docker Postgres  | Railway Staging DB     | Railway Production DB
# Razorpay Credentials | Test (`rzp_test_*`)    | Test (`rzp_test_*`)    | Live (`rzp_live_*`)
# Webhook Endpoint     | Ngrok / Mock Server    | staging.domain/webhook | domain.com/webhook
# User PII Data        | Dummy seed data        | Synthetic QA data only | Real subscriber records
# MedCity Health Vitals| Local mocked records   | Staging mock PDFs      | Encrypted prod bucket
# Hub Notifications    | Console log / mock     | Dev WhatsApp test line | Live Bangalore Hub Line
# ==============================================================================
