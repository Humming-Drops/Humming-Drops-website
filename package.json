{
  "name": "humming-drops-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run --no-cache",
    "test:unit": "vitest run --no-cache tests/unit",
    "test:smoke": "vitest run --no-cache tests/smoke",
    "test:vitest": "vitest run --no-cache",
    "test:services": "node --env-file=.env.local scripts/test-configured-services.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed-admin": "node --env-file=.env.local --loader ./tests/loader.mjs --experimental-strip-types scripts/seed-dev-admin.ts",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "postgres": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
